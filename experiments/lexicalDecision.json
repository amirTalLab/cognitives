  "simplifications": [
    { "what": "The paper's five stimulus types are reduced to three (associated, unassociated, nonword foil).", "why": "The associated-vs-unassociated contrast is the headline effect; one foil type keeps the yes/no decision genuine without the nonword-position sub-conditions that address the serial-processing model rather than priming." },
    { "what": "A fixed 24-pair set shown once each, rather than the paper's counterbalanced six-list rotation across subjects.", "why": "One shuffled balanced set shows the same within-subject RT effect in a classroom session." },
    { "what": "Per-block monetary incentive and RT feedback dropped; practice-with-feedback kept.", "why": "The incentive tuned absolute speed, not the association effect, which is a within-subject RT difference." }
  ]
