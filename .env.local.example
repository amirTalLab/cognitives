# These two are all you need to run the site, and all you need to build experiments from a
# terminal with Claude Code (npm run exp:check / exp:publish). Everything below is optional.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required only for the "Create New Project" feature (/create).
# Server-side only — do NOT prefix with NEXT_PUBLIC_, or the key ships to the browser.
# Without it the rest of the site works normally; /create just shows a "not configured" notice.
ANTHROPIC_API_KEY=sk-ant-...

# Lets /create create a generated experiment's results table automatically instead of you
# pasting SQL into the Supabase editor. A personal access token from the Supabase
# dashboard (Account -> Access Tokens). Server-side only.
# This token has owner rights over the whole project, so the SQL it runs is validated
# against a strict allow-list first (see lib/create-project/supabase-admin.ts).
SUPABASE_ACCESS_TOKEN=sbp_...

# Set to 1 to serve canned fixtures from /create instead of calling the API — lets the
# wizard be clicked through end to end with no key and no cost. Development only.
# CREATE_MOCK=1

# Optional model overrides.
# ANTHROPIC_MODEL_FAST=claude-sonnet-5     # reads the paper, drafts the spec
# ANTHROPIC_MODEL_STRONG=claude-opus-5     # writes and revises the experiment code
